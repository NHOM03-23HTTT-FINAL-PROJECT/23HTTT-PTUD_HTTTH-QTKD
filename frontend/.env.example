# Số phút không thao tác trước khi phiên tự kết thúc (mặc định 30). Đặt nhỏ, ví dụ 3, để kiểm thử nhanh.
VITE_SESSION_IDLE_MINUTES=30
# api: BE thật cho đăng nhập/đăng xuất; mock: prototype độc lập của các màn nghiệp vụ.
VITE_AUTH_MODE=api

# Enable the contracts API independently of other business features.
VITE_CONTRACTS_USE_BACKEND=false
