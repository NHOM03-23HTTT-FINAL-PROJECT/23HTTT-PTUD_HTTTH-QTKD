# Start with ./backend/Start-Api.ps1; plain dotnet run does not load this file.
# Generate a private random key (minimum 32 bytes); never commit the filled .env.
Jwt__SigningKey=
# Optional Npgsql key=value connection string. Leave blank to derive from DB/.env DIRECT_URL.
ConnectionStrings__Identity=
# Separate disposable Supabase test project only. Never point this to the shared project.
QTKD_TEST_DATABASE_CONNECTION=
QTKD_TEST_DATABASE_IS_DISPOSABLE=false
