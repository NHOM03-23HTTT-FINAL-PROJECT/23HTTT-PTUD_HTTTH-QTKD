{
  "name": "qtkd-database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.11.0"
  },
  "scripts": {
    "connection:check": "dotnet run --project ../backend/src/QTKD.DbTool -- connection-check",
    "migrate:status": "dotnet run --project ../backend/src/QTKD.DbTool -- status",
    "migrate:adopt": "dotnet run --project ../backend/src/QTKD.DbTool -- adopt",
    "migrate:deploy": "dotnet run --project ../backend/src/QTKD.DbTool -- migrate",
    "seed:check": "dotnet run --project ../backend/src/QTKD.DbTool -- seed --dry-run",
    "seed": "dotnet run --project ../backend/src/QTKD.DbTool -- seed",
    "test": "node --experimental-transform-types --test tests/identity-offline.test.mjs",
    "test:ef-parity": "node tests/ef-schema-parity.mjs",
    "test:dbtool": "dotnet build ../backend/src/QTKD.DbTool && node tests/dbtool-pglite.mjs",
    "test:contracts": "node tests/contracts-api.mjs",
    "check": "npm test && npm run test:ef-parity && npm run test:dbtool"
  },
  "dependencies": {
    "bcryptjs": "3.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@electric-sql/pglite-socket": "0.2.17",
    "pg": "8.16.3"
  }
}
