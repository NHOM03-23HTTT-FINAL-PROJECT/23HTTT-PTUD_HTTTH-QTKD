{
  "name": "qtkd-database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.11.0"
  },
  "scripts": {
    "format": "prisma format",
    "validate": "prisma validate",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:identity:offline": "node --experimental-transform-types --test tests/identity-offline.test.mjs",
    "seed:check": "tsx prisma/seed.ts --dry-run",
    "migration:check": "tsx scripts/check-migration.ts",
    "connection:check": "tsx scripts/check-connection.ts",
    "check": "npm run validate && npm run generate && npm run typecheck && npm test && npm run seed:check && npm run migration:check",
    "migrate:deploy": "tsx scripts/supabase.ts migrate",
    "migrate:status": "tsx scripts/supabase.ts status",
    "preseed": "npm run generate",
    "seed": "tsx scripts/supabase.ts seed",
    "test:contracts": "node --import tsx tests/contracts-api.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "dotenv": "17.2.3",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pg": "8.15.6",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "@electric-sql/pglite": "0.5.14",
    "@electric-sql/pglite-socket": "0.2.17"
  }
}
