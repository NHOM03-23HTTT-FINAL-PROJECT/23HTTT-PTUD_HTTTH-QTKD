# Copy to DB/.env only after creating a Supabase project. Never commit real values.
# Copy the exact Direct connection or Session pooler URI from Supabase > Connect.
# Use Session pooler port 5432 if your network cannot reach the direct IPv6 host.
# Do not use the Transaction pooler (port 6543) for migrations.
# Percent-encode reserved characters in the database password.
# Download the database CA via Database Settings > SSL Configuration if it is not trusted locally.
# Append &sslrootcert=C%3A%2Fcerts%2Fprod-ca-2021.crt using your actual certificate path.
DIRECT_URL="postgresql://postgres:REPLACE_ME@db.PROJECT_REF.supabase.co:5432/postgres?schema=qtkd&sslmode=verify-full"

# Only needed when explicitly running npm run seed; use a disposable demo password.
SEED_PASSWORD="REPLACE_WITH_A_DEMO_PASSWORD"
