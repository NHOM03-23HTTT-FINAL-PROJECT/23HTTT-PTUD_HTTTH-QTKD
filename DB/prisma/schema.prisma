// Complete 26-table data dictionary. Read DB/README.md before applying migrations.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["qtkd"]
}

enum UserRole {
  SalesStaff
  SalesManager
  OperationsStaff
  OperationsManager
  Accountant
  LegalStaff
  LegalManager
  BoardMember
  BoardChair
  SystemAdmin

  @@map("user_role")
  @@schema("qtkd")
}

enum UserStatus {
  Active
  TemporarilyLocked
  Disabled

  @@map("user_status")
  @@schema("qtkd")
}

enum SessionEndReason {
  Logout
  Expired
  Revoked

  @@map("session_end_reason")
  @@schema("qtkd")
}

enum RecordType {
  Contract
  PaymentStatement
  Customer
  Area
  PriceList
  VolumePeriod
  UserAccount

  @@map("record_type")
  @@schema("qtkd")
}

enum DocumentRecordType {
  Contract
  PaymentStatement

  @@map("document_record_type")
  @@schema("qtkd")
}

enum SendStatus {
  Pending
  Sent
  Failed

  @@map("send_status")
  @@schema("qtkd")
}

enum ActiveStatus {
  Active
  Suspended

  @@map("active_status")
  @@schema("qtkd")
}

enum CustomerDecisionType {
  Suspend
  Reactivate

  @@map("customer_decision_type")
  @@schema("qtkd")
}

enum ContractDocumentType {
  Contract
  Appendix
  CancellationAgreement
  TerminationRecord

  @@map("contract_document_type")
  @@schema("qtkd")
}

enum ContractStatus {
  Draft
  Submitted
  UnderReview
  RevisionRequested
  Rejected
  Approved
  Cancelled
  Active

  @@map("contract_status")
  @@schema("qtkd")
}

enum PriceListStatus {
  Draft
  Approved
  Effective
  Expired

  @@map("price_list_status")
  @@schema("qtkd")
}

enum VolumeStatus {
  Draft
  Confirmed
  Locked

  @@map("volume_status")
  @@schema("qtkd")
}

enum PaymentStatus {
  Draft
  Calculated
  Reconciled
  Submitted
  Approved
  Signing
  Signed
  Issued
  Rejected
  Revision
  Cancelled

  @@map("payment_status")
  @@schema("qtkd")
}

enum CustomerResult {
  Agreed
  Disagreed

  @@map("customer_result")
  @@schema("qtkd")
}

enum ChangeRequestType {
  Revision
  Cancellation
  Withdrawal

  @@map("change_request_type")
  @@schema("qtkd")
}

enum ChangeRequestStatus {
  Pending
  Approved
  Rejected

  @@map("change_request_status")
  @@schema("qtkd")
}

enum ApprovalResult {
  Running
  Completed
  RevisionRequested
  Rejected
  Withdrawn

  @@map("approval_result")
  @@schema("qtkd")
}

enum ApprovalStepStatus {
  NotStarted
  Pending
  Reviewing
  Completed
  Skipped

  @@map("approval_step_status")
  @@schema("qtkd")
}

enum ApprovalDecision {
  Approve
  RequestRevision
  Reject

  @@map("approval_decision")
  @@schema("qtkd")
}

enum SigningStatus {
  Signing
  Succeeded
  Failed
  Cancelled

  @@map("signing_status")
  @@schema("qtkd")
}

model Department {
  departmentId   String  @id @default(dbgenerated("gen_random_uuid()")) @map("department_id") @db.Uuid
  departmentName String  @map("department_name") @db.VarChar(200)
  code           String  @unique @map("code") @db.VarChar(16)
  managerId      String? @map("manager_id") @db.Uuid

  managerRef                UserAccount?  @relation("Department_managerId", fields: [managerId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  userAccountByDepartmentId UserAccount[] @relation("UserAccount_departmentId")

  @@index([managerId])
  @@map("department")
  @@schema("qtkd")
}

model UserAccount {
  userId             String     @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  username           String     @unique @map("username") @db.VarChar(100)
  companyEmail       String     @unique @map("company_email") @db.VarChar(254)
  passwordHash       String     @map("password_hash") @db.Text
  fullName           String     @map("full_name") @db.VarChar(200)
  departmentId       String     @map("department_id") @db.Uuid
  role               UserRole   @map("role")
  status             UserStatus @default(Active) @map("status")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  canSign            Boolean    @default(false) @map("can_sign")
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  roleRef            RoleDefinition @relation(fields: [role], references: [code], onDelete: Restrict, onUpdate: Restrict)

  departmentByManagerId               Department[]                  @relation("Department_managerId")
  departmentRef                       Department                    @relation("UserAccount_departmentId", fields: [departmentId], references: [departmentId], onDelete: Restrict, onUpdate: Restrict)
  loginSessionByUserId                LoginSession[]                @relation("LoginSession_userId")
  passwordOtpByUserId                 PasswordOtp[]                 @relation("PasswordOtp_userId")
  notificationByRecipientId           Notification[]                @relation("Notification_recipientId")
  auditLogByActorId                   AuditLog[]                    @relation("AuditLog_actorId")
  attachmentByUploadedBy              Attachment[]                  @relation("Attachment_uploadedBy")
  customerByAccountManagerId          Customer[]                    @relation("Customer_accountManagerId")
  customerProfileCreated CustomerProfileData[] @relation("CustomerProfileCreatedBy")
  customerOperations CustomerOperation[]
  customerStatusDecisionByConfirmedBy CustomerStatusDecision[]      @relation("CustomerStatusDecision_confirmedBy")
  areaAssignmentByUserId              AreaAssignment[]              @relation("AreaAssignment_userId")
  contractByOwnerId                   Contract[]                    @relation("Contract_ownerId")
  priceListByCreatedBy                PriceList[]                   @relation("PriceList_createdBy")
  volumePeriodByLockedBy              VolumePeriod[]                @relation("VolumePeriod_lockedBy")
  paymentStatementByCreatedBy         PaymentStatement[]            @relation("PaymentStatement_createdBy")
  reconciliationByVolumeConfirmedBy   Reconciliation[]              @relation("Reconciliation_volumeConfirmedBy")
  reconciliationByReconciledBy        Reconciliation[]              @relation("Reconciliation_reconciledBy")
  changeRequestByRequestedBy          ChangeRequest[]               @relation("ChangeRequest_requestedBy")
  changeRequestByApprovedBy           ChangeRequest[]               @relation("ChangeRequest_approvedBy")
  approvalRoundBySubmittedBy          ApprovalRound[]               @relation("ApprovalRound_submittedBy")
  approvalStepByAssigneeId            ApprovalStep[]                @relation("ApprovalStep_assigneeId")
  approvalStepByDecidedBy             ApprovalStep[]                @relation("ApprovalStep_decidedBy")
  signingSessionByCompanySignerId     SigningSession[]              @relation("SigningSession_companySignerId")
  signingSessionBySentBy              SigningSession[]              @relation("SigningSession_sentBy")
  requestedCancellations              ContractCancellationRequest[] @relation("CancellationRequester")
  salesCancellations                  ContractCancellationRequest[] @relation("CancellationSales")
  boardCancellations                  ContractCancellationRequest[] @relation("CancellationBoard")

  @@index([departmentId])
  @@map("user_account")
  @@schema("qtkd")
}

model LoginSession {
  sessionId        String            @id @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  refreshTokenHash String            @unique @map("refresh_token_hash") @db.VarChar(256)
  logoutTokenHash  String            @unique @map("logout_token_hash") @db.VarChar(256)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActivityAt   DateTime          @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  remember         Boolean           @default(false) @map("remember")
  revocationReason String?           @map("revocation_reason") @db.VarChar(50)
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(6)
  isRevoked        Boolean           @default(false) @map("is_revoked")
  endReason        SessionEndReason? @map("end_reason")
  ipAddress        String?           @map("ip_address") @db.VarChar(45)
  device           String?           @map("device") @db.VarChar(500)

  userRef UserAccount @relation("LoginSession_userId", fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([userId, isRevoked, expiresAt])
  @@map("login_session")
  @@schema("qtkd")
}

model RoleDefinition {
  code           UserRole @id @map("code")
  name           String @map("name") @db.VarChar(100)
  departmentCode String @map("department_code") @db.VarChar(16)
  users          UserAccount[]
  permissions    RolePermission[]
  @@map("role_definition")
  @@schema("qtkd")
}

model Permission {
  code  String @id @map("code") @db.VarChar(100)
  name  String @map("name") @db.VarChar(200)
  roles RolePermission[]
  @@map("permission")
  @@schema("qtkd")
}

model RolePermission {
  role           UserRole @map("role")
  permissionCode String @map("permission_code") @db.VarChar(100)
  roleRef RoleDefinition @relation(fields: [role], references: [code], onDelete: Restrict, onUpdate: Restrict)
  permissionRef Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  @@id([role, permissionCode])
  @@map("role_permission")
  @@schema("qtkd")
}

model PasswordOtp {
  otpId       String   @id @default(dbgenerated("gen_random_uuid()")) @map("otp_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  otpHash     String   @map("otp_hash") @db.VarChar(256)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  failedCount Int      @default(0) @map("failed_count")
  isUsed      Boolean  @default(false) @map("is_used")
  sentAt      DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  userRef UserAccount @relation("PasswordOtp_userId", fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([userId, sentAt])
  @@map("password_otp")
  @@schema("qtkd")
}

model Notification {
  notificationId String     @id @default(dbgenerated("gen_random_uuid()")) @map("notification_id") @db.Uuid
  recipientId    String     @map("recipient_id") @db.Uuid
  recordType     RecordType @map("record_type")
  recordId       String     @map("record_id") @db.Uuid
  content        String     @map("content") @db.Text
  isRead         Boolean    @default(false) @map("is_read")
  sendStatus     SendStatus @default(Pending) @map("send_status")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  recipientRef UserAccount @relation("Notification_recipientId", fields: [recipientId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([recipientId])
  @@index([recipientId, isRead, createdAt])
  @@index([sendStatus, createdAt])
  @@map("notification")
  @@schema("qtkd")
}

model AuditLog {
  logId        String   @id @default(dbgenerated("gen_random_uuid()")) @map("log_id") @db.Uuid
  entityType   String   @map("entity_type") @db.VarChar(100)
  entityId     String?  @map("entity_id") @db.Uuid
  action       String   @map("action") @db.VarChar(100)
  actorId      String?  @map("actor_id") @db.Uuid
  actedAt      DateTime @default(now()) @map("acted_at") @db.Timestamptz(6)
  statusBefore String?  @map("status_before") @db.VarChar(50)
  statusAfter  String?  @map("status_after") @db.VarChar(50)
  valueBefore  Json?    @map("value_before") @db.JsonB
  valueAfter   Json?    @map("value_after") @db.JsonB
  note         String?  @map("note") @db.Text
  ipAddress    String?  @map("ip_address") @db.VarChar(45)

  actorRef UserAccount? @relation("AuditLog_actorId", fields: [actorId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorId])
  @@index([entityType, entityId, actedAt])
  @@map("audit_log")
  @@schema("qtkd")
}

model Attachment {
  fileSize     BigInt             @default(0) @map("file_size")
  contentType  String             @default("application/octet-stream") @map("content_type") @db.VarChar(200)
  attachmentId String             @id @default(dbgenerated("gen_random_uuid()")) @map("attachment_id") @db.Uuid
  recordType   DocumentRecordType @map("record_type")
  contractId   String?            @map("contract_id") @db.Uuid
  statementId  String?            @map("statement_id") @db.Uuid
  fileName     String             @map("file_name") @db.VarChar(255)
  filePath     String             @map("file_path") @db.Text
  uploadedBy   String             @map("uploaded_by") @db.Uuid
  uploadedAt   DateTime           @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  contractRef                  Contract?         @relation("Attachment_contractId", fields: [contractId], references: [contractId], onDelete: Restrict, onUpdate: Restrict)
  statementRef                 PaymentStatement? @relation("Attachment_statementId", fields: [statementId], references: [statementId], onDelete: Restrict, onUpdate: Restrict)
  uploadedByRef                UserAccount       @relation("Attachment_uploadedBy", fields: [uploadedBy], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  signingSessionBySignedFileId SigningSession[]  @relation("SigningSession_signedFileId")

  @@index([contractId])
  @@index([statementId])
  @@index([uploadedBy])
  @@map("attachment")
  @@schema("qtkd")
}

model Customer {
  customerCode        String       @unique @default(dbgenerated("('KH-'::text || lpad((nextval('qtkd.customer_code_seq'::regclass))::text, 6, '0'::text))")) @map("customer_code") @db.VarChar(50)
  customerId          String       @id @default(dbgenerated("gen_random_uuid()")) @map("customer_id") @db.Uuid
  customerName        String       @map("customer_name") @db.VarChar(250)
  taxCode             String       @unique @map("tax_code") @db.VarChar(13)
  address             String       @map("address") @db.Text
  legalRepresentative String       @map("legal_representative") @db.VarChar(200)
  contactName         String?      @map("contact_name") @db.VarChar(200)
  contactTitle        String?      @map("contact_title") @db.VarChar(150)
  phone               String?      @map("phone") @db.VarChar(30)
  email               String?      @map("email") @db.VarChar(254)
  customerGroup       String?      @map("customer_group") @db.VarChar(100)
  interestedServices  String?      @map("interested_services") @db.Text
  status              ActiveStatus @default(Active) @map("status")
  accountManagerId    String       @map("account_manager_id") @db.Uuid
  version             Int          @default(1) @map("version")
  customerUpdatedAt   DateTime?    @map("customer_updated_at") @db.Timestamptz(6)
  flowRevision        Int          @default(0) @map("flow_revision")

  accountManagerRef                  UserAccount              @relation("Customer_accountManagerId", fields: [accountManagerId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  customerStatusDecisionByCustomerId CustomerStatusDecision[] @relation("CustomerStatusDecision_customerId")
  profileData                        CustomerProfileData?
  operations                         CustomerOperation[]
  contractByCustomerId               Contract[]               @relation("Contract_customerId")

  @@index([accountManagerId])
  @@map("customer")
  @@schema("qtkd")
}

// Legacy customers may not have creation metadata; do not invent a creator or date.
model CustomerProfileData {
  customerId    String    @id @map("customer_id") @db.Uuid
  serviceGroups String[]  @default([]) @map("service_groups")
  createdAt     DateTime? @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(6)
  customerRef   Customer  @relation(fields: [customerId], references: [customerId], onDelete: Restrict, onUpdate: Restrict)
  creatorRef    UserAccount? @relation("CustomerProfileCreatedBy", fields: [createdBy], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@map("customer_profile_data")
  @@schema("qtkd")
}

model CustomerOperation {
  actorId     String   @map("actor_id") @db.Uuid
  operation   String   @db.VarChar(40)
  requestKey  String   @map("request_key") @db.VarChar(100)
  requestHash String   @map("request_hash") @db.VarChar(64)
  customerId  String   @map("customer_id") @db.Uuid
  response    Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorRef    UserAccount @relation(fields: [actorId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  customerRef Customer @relation(fields: [customerId], references: [customerId], onDelete: Restrict, onUpdate: Restrict)

  @@id([actorId, operation, requestKey])
  @@index([customerId])
  @@map("customer_operation")
  @@schema("qtkd")
}

model CustomerStatusDecision {
  decisionId   String               @id @default(dbgenerated("gen_random_uuid()")) @map("decision_id") @db.Uuid
  customerId   String               @map("customer_id") @db.Uuid
  decisionType CustomerDecisionType @map("decision_type")
  reason       String               @map("reason") @db.Text
  basis        String?              @map("basis") @db.Text
  followUpPlan String?              @map("follow_up_plan") @db.Text
  confirmedBy  String               @map("confirmed_by") @db.Uuid
  decidedAt    DateTime             @default(now()) @map("decided_at") @db.Timestamptz(6)

  customerRef    Customer    @relation("CustomerStatusDecision_customerId", fields: [customerId], references: [customerId], onDelete: Restrict, onUpdate: Restrict)
  confirmedByRef UserAccount @relation("CustomerStatusDecision_confirmedBy", fields: [confirmedBy], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([customerId])
  @@index([confirmedBy])
  @@map("customer_status_decision")
  @@schema("qtkd")
}

model Area {
  areaId               String       @id @default(dbgenerated("gen_random_uuid()")) @map("area_id") @db.Uuid
  areaCode             String       @unique @map("area_code") @db.VarChar(50)
  areaName             String       @map("area_name") @db.VarChar(200)
  areaType             String       @map("area_type") @db.VarChar(100)
  parentAreaId         String?      @map("parent_area_id") @db.Uuid
  level                Int          @default(1) @map("level")
  hierarchyPath        String       @map("hierarchy_path") @db.Text
  coordinates          String?      @map("coordinates") @db.Text
  areaM2               Decimal      @map("area_m2") @db.Decimal(19, 4)
  capacity             Decimal      @map("capacity") @db.Decimal(19, 4)
  technicalDescription String?      @map("technical_description") @db.Text
  status               ActiveStatus @default(Active) @map("status")
  rowVersion           Int          @default(1) @map("row_version")

  parentAreaRef          Area?            @relation("Area_parentAreaId", fields: [parentAreaId], references: [areaId], onDelete: Restrict, onUpdate: Restrict)
  areaByParentAreaId     Area[]           @relation("Area_parentAreaId")
  areaServiceByAreaId    AreaService[]    @relation("AreaService_areaId")
  areaAssignmentByAreaId AreaAssignment[] @relation("AreaAssignment_areaId")
  contractItemByAreaId   ContractItem[]   @relation("ContractItem_areaId")
  priceListLineByAreaId  PriceListLine[]  @relation("PriceListLine_areaId")
  volumeLineByAreaId     VolumeLine[]     @relation("VolumeLine_areaId")

  @@index([parentAreaId])
  @@map("area")
  @@schema("qtkd")
}

model Service {
  serviceCode  String  @unique @default(dbgenerated("('DV-'::text || lpad((nextval('qtkd.service_code_seq'::regclass))::text, 6, '0'::text))")) @map("service_code") @db.VarChar(50)
  requiresArea Boolean @default(true) @map("requires_area")
  serviceId    String  @id @default(dbgenerated("gen_random_uuid()")) @map("service_id") @db.Uuid
  serviceName  String  @map("service_name") @db.VarChar(200)
  unit         String  @map("unit") @db.VarChar(50)
  isMandatory  Boolean @default(false) @map("is_mandatory")

  areaServiceByServiceId   AreaService[]   @relation("AreaService_serviceId")
  contractItemByServiceId  ContractItem[]  @relation("ContractItem_serviceId")
  priceListLineByServiceId PriceListLine[] @relation("PriceListLine_serviceId")
  volumeLineByServiceId    VolumeLine[]    @relation("VolumeLine_serviceId")

  @@map("service")
  @@schema("qtkd")
}

model AreaService {
  areaId    String @map("area_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  areaRef    Area    @relation("AreaService_areaId", fields: [areaId], references: [areaId], onDelete: Restrict, onUpdate: Restrict)
  serviceRef Service @relation("AreaService_serviceId", fields: [serviceId], references: [serviceId], onDelete: Restrict, onUpdate: Restrict)

  @@id([areaId, serviceId])
  @@index([areaId])
  @@index([serviceId])
  @@map("area_service")
  @@schema("qtkd")
}

model AreaAssignment {
  assignmentId String    @id @default(dbgenerated("gen_random_uuid()")) @map("assignment_id") @db.Uuid
  areaId       String    @map("area_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  fromDate     DateTime  @map("from_date") @db.Timestamptz(6)
  toDate       DateTime? @map("to_date") @db.Timestamptz(6)

  areaRef Area        @relation("AreaAssignment_areaId", fields: [areaId], references: [areaId], onDelete: Restrict, onUpdate: Restrict)
  userRef UserAccount @relation("AreaAssignment_userId", fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([areaId])
  @@index([userId])
  @@map("area_assignment")
  @@schema("qtkd")
}

model Contract {
  contractCode       String               @unique @default(dbgenerated("('HD-'::text || lpad((nextval('qtkd.contract_code_seq'::regclass))::text, 6, '0'::text))")) @map("contract_code") @db.VarChar(50)
  sourceMode         String               @default("blank") @map("source_mode") @db.VarChar(20)
  templateCode       String?              @map("template_code") @db.VarChar(80)
  customerSnapshot   Json                 @default("{}") @map("customer_snapshot") @db.JsonB
  owningDepartmentId String?              @map("owning_department_id") @db.Uuid
  cancelledBy        String?              @map("cancelled_by") @db.Uuid
  cancelledAt        DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?              @map("cancellation_reason") @db.Text
  contractId         String               @id @default(dbgenerated("gen_random_uuid()")) @map("contract_id") @db.Uuid
  documentType       ContractDocumentType @default(Contract) @map("document_type")
  parentContractId   String?              @map("parent_contract_id") @db.Uuid
  customerId         String               @map("customer_id") @db.Uuid
  title              String               @map("title") @db.VarChar(500)
  contractType       String               @map("contract_type") @db.VarChar(100)
  startDate          DateTime             @map("start_date") @db.Date
  endDate            DateTime             @map("end_date") @db.Date
  contractValue      Decimal              @map("contract_value") @db.Decimal(19, 2)
  paymentTerms       String               @map("payment_terms") @db.Text
  content            String               @map("content") @db.Text
  status             ContractStatus       @default(Draft) @map("status")
  ownerId            String               @map("owner_id") @db.Uuid
  version            Int                  @default(1) @map("version")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  attachmentByContractId       Attachment[]                  @relation("Attachment_contractId")
  parentContractRef            Contract?                     @relation("Contract_parentContractId", fields: [parentContractId], references: [contractId], onDelete: Restrict, onUpdate: Restrict)
  contractByParentContractId   Contract[]                    @relation("Contract_parentContractId")
  customerRef                  Customer                      @relation("Contract_customerId", fields: [customerId], references: [customerId], onDelete: Restrict, onUpdate: Restrict)
  ownerRef                     UserAccount                   @relation("Contract_ownerId", fields: [ownerId], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  contractItemByContractId     ContractItem[]                @relation("ContractItem_contractId")
  priceListByContractId        PriceList[]                   @relation("PriceList_contractId")
  volumePeriodByContractId     VolumePeriod[]                @relation("VolumePeriod_contractId")
  paymentStatementByContractId PaymentStatement[]            @relation("PaymentStatement_contractId")
  changeRequestByContractId    ChangeRequest[]               @relation("ChangeRequest_contractId")
  approvalRoundByContractId    ApprovalRound[]               @relation("ApprovalRound_contractId")
  signingSessionByContractId   SigningSession[]              @relation("SigningSession_contractId")
  cancellationRequests         ContractCancellationRequest[]
  deliveries                   ContractDelivery[]

  @@index([parentContractId])
  @@index([customerId])
  @@index([ownerId])
  @@index([status, ownerId])
