model PaymentStatement {
  statementId            String        @id @default(dbgenerated("gen_random_uuid()")) @map("statement_id") @db.Uuid
  contractId             String        @map("contract_id") @db.Uuid
  billingPeriod          String        @map("billing_period") @db.VarChar(7)
  priceListId            String        @map("price_list_id") @db.Uuid
  volumePeriodId         String        @map("volume_period_id") @db.Uuid
  customerNameSnapshot   String        @map("customer_name_snapshot") @db.VarChar(250)
  taxCodeSnapshot        String        @map("tax_code_snapshot") @db.VarChar(13)
  addressSnapshot        String        @map("address_snapshot") @db.Text
  representativeSnapshot String        @map("representative_snapshot") @db.VarChar(200)
  subtotal               Decimal       @map("subtotal") @db.Decimal(19, 2)
  taxAmount              Decimal       @map("tax_amount") @db.Decimal(19, 2)
  totalAmount            Decimal       @map("total_amount") @db.Decimal(19, 2)
  status                 PaymentStatus @default(Draft) @map("status")
  originalStatementId    String?       @map("original_statement_id") @db.Uuid
  createdBy              String        @map("created_by") @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  issuedAt               DateTime?     @map("issued_at") @db.Timestamptz(6)
  isLocked               Boolean       @default(false) @map("is_locked")

  attachmentByStatementId               Attachment[]           @relation("Attachment_statementId")
  contractRef                           Contract               @relation("PaymentStatement_contractId", fields: [contractId], references: [contractId], onDelete: Restrict, onUpdate: Restrict)
  priceListRef                          PriceList              @relation("PaymentStatement_priceListId", fields: [priceListId], references: [priceListId], onDelete: Restrict, onUpdate: Restrict)
  volumePeriodRef                       VolumePeriod           @relation("PaymentStatement_volumePeriodId", fields: [volumePeriodId], references: [volumePeriodId], onDelete: Restrict, onUpdate: Restrict)
  originalStatementRef                  PaymentStatement?      @relation("PaymentStatement_originalStatementId", fields: [originalStatementId], references: [statementId], onDelete: Restrict, onUpdate: Restrict)
  paymentStatementByOriginalStatementId PaymentStatement[]     @relation("PaymentStatement_originalStatementId")
  createdByRef                          UserAccount            @relation("PaymentStatement_createdBy", fields: [createdBy], references: [userId], onDelete: Restrict, onUpdate: Restrict)
  paymentStatementLineByStatementId     PaymentStatementLine[] @relation("PaymentStatementLine_statementId")
  reconciliationByStatementId           Reconciliation?        @relation("Reconciliation_statementId")
  changeRequestByStatementId            ChangeRequest[]        @relation("ChangeRequest_statementId")
  approvalRoundByStatementId            ApprovalRound[]        @relation("ApprovalRound_statementId")
  signingSessionByStatementId           SigningSession[]       @relation("SigningSession_statementId")

  @@index([contractId])
  @@index([priceListId])
  @@index([volumePeriodId])
  @@index([originalStatementId])
  @@index([createdBy])
  @@map("payment_statement")
  @@schema("qtkd")
}

